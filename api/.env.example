# .env.example
# Example environment configuration for LORI AI Safeguard API
# Rename this file to `.env` and fill in real credentials before running.

# ─────────────────────────────
#  Server Configuration
# ─────────────────────────────
PORT=8080
NODE_ENV=development

# ─────────────────────────────
#  Stripe / Payment Gateway
# (Use test keys from Stripe dashboard for development)
# ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_yourkeyhere
STRIPE_WEBHOOK_SECRET=whsec_yourwebhooksecret
# Symbolic verification fee: $1.99 = 199 cents
LORI_SYMBOLIC_USD=199
# Corporate deposit: $1,000 = 100000 cents
LORI_CORPORATE_DEPOSIT_USD=100000

# ─────────────────────────────
#  Risk & Security Parameters
# ─────────────────────────────
RISK_THRESHOLD_FREEZE=70
RISK_THRESHOLD_LIMIT=55
RATE_LIMIT_REGISTRATIONS_PER_HOUR=5
RATE_LIMIT_API_CALLS_PER_MINUTE=120

# ─────────────────────────────
#  Verification / KYC Providers
# (Optional: integrate with external ID services)
# ─────────────────────────────
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_ENDPOINT=

# ─────────────────────────────
#  Logging / Audit
# ─────────────────────────────
LOG_DIR=logs
LOG_LEVEL=info

# ─────────────────────────────
#  Encryption / Hashing
# ─────────────────────────────
JWT_SECRET=replace_with_strong_secret_key
HASH_SALT_ROUNDS=12

# ─────────────────────────────
#  Legal & Policy Identifiers
# ─────────────────────────────
LORI_SEMANTIC_FINGERPRINT_ID=LORI-AISG-20251029-CORE
LORI_POLICY_VERSION=2.0
LORI_LICENSE_TYPE=LORI_CIL_ENTERPRISE

# End of file
